# Copy this to deploy/provision.env (gitignored) and fill in real values.
# provision-tenant.sh sources it for the secrets it needs but shouldn't
# hardcode in a committed script.

REPO_URL="git@your-git-host:you/cubrel.git"

# Shared app-level DB user that gets granted access to each new tenant DB.
# (Each tenant still gets its own database, just the same login.)
DB_USERNAME="cubrel"
DB_PASSWORD="change-me"

# Only set this if you want provision-tenant.sh to create the tenant's
# database automatically. Leave blank to create databases by hand instead.
MYSQL_ROOT_PASSWORD=""

# Shared mail account across every tenant. All optional — anything left
# blank falls back to a sane default (log driver, i.e. no real mail sent).
# MAIL_FROM_ADDRESS defaults to noreply@<tenant-domain> if left unset.
MAIL_MAILER="smtp"
MAIL_HOST=""
MAIL_PORT="2525"
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_ENCRYPTION="tls"
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME=""

# Powers BCC email capture (Emails module — see
# app/Http/Controllers/EmailInboundWebhookController.php). Set once,
# server-wide, by deploy/setup-postfix.sh (which prints the value to put
# here) — not a per-tenant secret, since it's just the shared trust
# between this server's own Postfix relay and every tenant app on it.
# Leave blank to skip: the Emails module still works for manual entry.
INBOUND_RELAY_SECRET=""
