APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed the worst-case runtime of ProcessImportJob (its own $timeout is 3600s) —

DB_QUEUE_RETRY_AFTER=3600

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


MAIL_MAILER=smtp
MAIL_HOST=live.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=smtp@mailtrap.io
MAIL_ENCRYPTION=tls
MAIL_PASSWORD=25e6618c27290caea83851c8c06fab01
MAIL_FROM_ADDRESS=noreply@cubrel.com
MAIL_FROM_NAME="Cubrel"

# Verifies Mailtrap's inbound-email webhook (BCC capture — see
# EmailInboundWebhookController). Templated per-tenant by
# deploy/provision-tenant.sh; blank means inbound capture is disabled.
MAILTRAP_API_TOKEN=
MAILTRAP_INBOUND_WEBHOOK_SECRET=


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reverb: REVERB_SERVER_HOST/PORT are what `reverb:start` actually binds to.
# REVERB_HOST/PORT/SCHEME are separate — what Laravel's server-side broadcaster
# uses to reach Reverb's internal REST API to publish events; keep them equal
# to REVERB_SERVER_HOST/PORT unless you have a reason not to. Neither of these
# is what the browser connects to — see VITE_REVERB_* below for that.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_SERVER_HOST="127.0.0.1"
REVERB_SERVER_PORT=8080
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http

# VITE_REVERB_* are what the browser connects to — must be the public-facing
# host/port/scheme (proxied to REVERB_SERVER_HOST/PORT over wss:// by nginx).
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
